{
  "name": "bb-plugin-guided-review",
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "bb": ">=0.41.0",
    "bbPluginSdk": ">=0.4.34",
    "node": ">=24"
  },
  "bb": {
    "name": "Guided Review",
